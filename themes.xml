<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Studio" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="Theme.Studio.SplashScreen" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#080810</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenBrandingImage">@drawable/ic_splash</item>
        <item name="postSplashScreenTheme">@style/Theme.Studio</item>
    </style>
</resources>
